# ==============================================================================
# CẤU HÌNH TRẠM TIẾP NHẬN, KIỂM ĐỊNH CHẤT LƯỢNG & ĐỊNH LƯỢNG DINH DƯỠNG THỰC PHẨM
# ==============================================================================

# Chế độ phần cứng giả lập:
# - True  : Giả lập Camera, HX711 Loadcell, LCD I2C (dùng để dev/test trên Windows)
# - False : Dùng phần cứng thật trên Raspberry Pi 4
MOCK_HARDWARE=True

# Tên trạm & đơn vị vận hành (hiển thị trên giao diện và phiếu xuất/báo cáo)
STATION_ID=STATION-KITCHEN-01
STATION_NAME=Bếp Ăn Tập Thể - Cổng Tiếp Nhận Số 1

# Cảm biến trọng lượng Loadcell (5kg) & ADC 24-bit HX711 (BCM GPIO)
HX711_DT_PIN=5
HX711_SCK_PIN=6
HX711_INVERT_SIGNAL=1
HX711_ZERO_BAND_G=0.5
HX711_MEDIAN_SAMPLES=3
WEIGHT_SAMPLE_HZ=10

# Ngưỡng State Machine cân tự động (gram & giây) - có vùng trễ hysteresis (nhả < 8g, đặt >= 15g)
IDLE_WEIGHT_G=8.0
DETECT_WEIGHT_G=15.0
STABILITY_DELTA_G=2.0
STABILITY_HOLD_S=1.0

# Màn hình LCD 16x2 I2C (chip PCF8574)
LCD_I2C_ADDRESS=0x27
LCD_I2C_PORT=1
LCD_COLS=16
LCD_ROWS=2

# Camera USB (V4L2 trên Pi 4 / DirectShow trên Windows)
CAMERA_INDEX=0
CAMERA_DEVICE=/dev/video0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30
CAMERA_FOURCC=MJPG
CAMERA_BUFFERSIZE=1

# Trí tuệ nhân tạo YOLO26n (NCNN tối ưu CPU ARM Cortex-A72)
# auto | ncnn | ultralytics | mock
AI_STRATEGY=auto
AI_CONFIDENCE_THRESHOLD=0.50
AI_NMS_IOU_THRESHOLD=0.45
AI_INPUT_SIZE=416
AI_NUM_THREADS=4

# Máy chủ Backend FastAPI & WebSocket
HOST=0.0.0.0
PORT=8000
DEBUG=0
CORS_ORIGINS=*

# Bảo mật trang hiệu chuẩn / quản trị (để trống nếu không yêu cầu PIN)
ADMIN_PIN=
